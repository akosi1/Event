# ===============================================================
# Laravel Root .htaccess — Secure + Hostinger Compatible (Safe for Login)
# ===============================================================


  RewriteEngine On

  # 🚫 Block direct /public access
  RewriteCond %{THE_REQUEST} "\s/public([/?#\s]|$)" [NC]
  RewriteRule ^ - [R=403,L]

  # 🚫 Block direct /index.php access
  RewriteCond %{THE_REQUEST} "^[A-Z]{3,}\s/+index\.php[?\s]" [NC]
  RewriteRule ^index\.php$ - [R=403,L]

  # ✅ Redirect everything else INTO /public (but not twice)
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]

  # 🧱 Strict block for sensitive images (Hostinger-safe)
  # Allows internal loading, blocks manual direct browser access
  RewriteCond %{THE_REQUEST} "GET\s+/+(logo\.png|header\.png|watermark\.png)[\s?]" [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?mccgradeinfo\.com [NC]
  RewriteRule ^(logo\.png|header\.png|watermark\.png)$ - [R=403,L]


# ===============================================================
# 🔒 Security Hardening
# ===============================================================
RedirectMatch 404 /\.(env|git|ht|DS_Store)
RedirectMatch 404 /\.env\..*
RedirectMatch 404 ^/(storage|vendor|bootstrap|resources|config)/.*

Options -Indexes

# ===============================================================
# 🛡️ Security Headers
# ===============================================================

  Header always set X-XSS-Protection "1; mode=block"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), fullscreen=(self)"