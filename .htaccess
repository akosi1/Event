# Root .htaccess (outside /public)
# ------------------------------------------------
# WARNING DO NOT TOUCH THIS
# ------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files
    RewriteRule ^(\.env|config|vendor|storage|bootstrap|artisan|composer\.json|composer\.lock)$ - [F,L,NC]

    # Redirect anyone trying to access /public manually
    RewriteCond %{THE_REQUEST} \s/public/ [NC]
    RewriteRule ^public(/.*)?$ / [R=301,L]
</IfModule>

# Block access to hidden files (.git, .env, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Disable directory listings
Options -Indexes
